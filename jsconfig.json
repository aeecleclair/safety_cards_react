{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./app/components/*"],
      "@/providers/*": ["./app/providers/*"],
      "@/views/*": ["./src/views/*"],
      "@/src/*": ["./src/*"],
      "@/locales/*": ["./src/locales/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"],
  "exclude": ["node_modules"]
}
